   if (SPLASH_NEEDED() && splashStarted) {
     resetBacklightTimeout();
+#if LCD_W == 128 && LCD_H == 64
+    // Animation GaboLabs : chaque image reste affichée sa durée, une touche ou un manche l'interrompt
+    // La LED du bouton d'alimentation suit l'horloge de l'animation, puis reprend sa couleur normale
+    getADC();
+    inactivityCheckInputs();
+    tmr10ms_t debut = get_tmr10ms();
+    tmr10ms_t fin = debut;
+    for (uint16_t f = 0; f < gabolabsFrameCount(); f++) {
+      drawGabolabsFrame(f);
+      fin += gabolabsFrameDuration(f);  // échéances cumulées : pas de dérive
+      while (fin > get_tmr10ms()) {
+        sleep_ms(1);
+        gabolabsLedUpdate(get_tmr10ms() - debut);
+        getADC();
+        // Seule une touche interrompt l'animation (un manche ou un inter mal placé ne la coupe
+        // plus : les alertes de démarrage s'affichent après). La bande-son s'arrête avec elle.
+        if (getEvent()) {
+          audioQueue.stopAll();
+          gabolabsLedRestore();
+          return;
+        }
+        if (pwrCheck() == e_power_off) {
+          gabolabsLedRestore();
+          return;
+        }
+        checkBacklight();
+      }
+    }
+    gabolabsLedRestore();
+    return;
+#endif
     drawSplash();
 
     getADC(); // init ADC array
